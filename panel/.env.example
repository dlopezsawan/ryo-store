# Medusa Admin API base URL — el panel hace fetch server-side contra esto.
# Local dev: http://localhost:9000
# VPS via docker network: http://medusa:9000
# Producción externa: https://api.enrola.shop
MEDUSA_ADMIN_URL=http://localhost:9000

# Secret para firmar la cookie de sesión (HS256). Generar con:
#   openssl rand -base64 48
# DEBE ser distinto en cada ambiente. NO commitear el .env real.
PANEL_SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# Cookie domain en producción (para que el browser la asocie al subdominio).
# Local dev: dejar vacío. Prod: panel.enrola.shop
PANEL_COOKIE_DOMAIN=

# Opcional: forzar HTTPS-only en cookies. true en prod, false en dev local.
PANEL_COOKIE_SECURE=false
