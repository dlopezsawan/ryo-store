{
  "name": "backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "add-venezuela-shipping": "medusa exec ./src/scripts/add-venezuela-shipping.ts",
    "get-publishable-key": "medusa exec ./src/scripts/get-publishable-key.ts",
    "setup-venezuela": "medusa exec ./src/scripts/setup-venezuela.ts",
    "fix-sales-channel": "medusa exec ./src/scripts/fix-sales-channel-stock-location.ts",
    "fix-product-prices": "medusa exec ./src/scripts/fix-product-prices.ts",
    "fix-shipping-profiles": "medusa exec ./src/scripts/fix-shipping-profiles.ts",
    "seed-seo": "medusa exec ./src/scripts/seed-seo-analytics.ts",
    "social:sync": "medusa exec ./src/scripts/social-sync.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.13.1",
    "@medusajs/cli": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-font-family": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/react-big-calendar": "^1.16.3",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "imapflow": "^1.3.3",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.2",
    "react-big-calendar": "^1.19.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.9.0"
}
